<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.lucas.controller.UserController">

  <padding>
    <Insets top="20" right="20" bottom="20" left="20"/>
  </padding>

  <Label text="User Registration System" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

  <TextField fx:id="txtCpf" promptText="CPF (999.999.999-99)"/>
  <TextField fx:id="txtName" promptText="Full Name"/>
  <TextField fx:id="txtEmail" promptText="Email Address"/>
  <PasswordField fx:id="txtPassword" promptText="Password"/>
  <ComboBox fx:id="cbmAffiliation" promptText="Select Affiliation">
    <items>
      <FXCollections fx:factory="observableArrayList">
        <String plac fx:value="Default"/>
        <String fx:value="Professor"/>
        <String fx:value="Student"/>
      </FXCollections>
    </items>
  </ComboBox>

  <Button text="Register User" onAction="#handleRegister" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
  <Label fx:id="lblStatus" style="-fx-text-fill: red;"/>
</VBox>

